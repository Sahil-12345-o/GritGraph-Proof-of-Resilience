{
  "name": "gritgraph",
  "displayName": "GritGraph",
  "description": "Proof-of-Resilience for developers",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:gritgraph.startSession",
    "onCommand:gritgraph.endSession"
],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
        {
            "command": "gritgraph.startSession",
            "title": "GritGraph: Start Debugging Session"
        },
        {
            "command": "gritgraph.endSession",
            "title": "GritGraph: End Debugging Session"
        }
    ]
},
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "unit-test": "npm run compile-tests && npx mocha --timeout 10000 out/test/unit/commandClassifier.test.js out/test/unit/sanitizer.test.js out/test/unit/problemManager.test.js out/test/unit/journeyAnalyzer.test.js out/test/unit/gritScoreEngine.test.js",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}

